# Flask
FLASK_ENV=development
SECRET_KEY=change-this-secret-key

# Database
DATABASE_URL=

# AI Providers
AI_PROVIDER=auto
EMBEDDING_PROVIDER=auto

# Google Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4

# Email
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=StudyMind AI <no-reply@example.com>

# RAG Settings
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=5
DEFAULT_AI_TEMPERATURE=0.4

PORT=5000